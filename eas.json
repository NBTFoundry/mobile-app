{
  "cli": {
    "version": ">= 27.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "corepack": true,
      "autoIncrement": true,
      "channel": "production",
      "uploadSourceMaps": true,
      "env": {
        "NBT_VERSION_CODE": "1000"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
