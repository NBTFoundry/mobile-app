{
  "cli": {
    "version": ">= 27.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "node": "24.22.2",
      "corepack": true,
      "autoIncrement": true,
      "env": {
        "NBT_VERSION_CODE": "1000"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
